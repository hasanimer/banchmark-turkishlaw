# Anthropic kimlik bilgisi. `ant auth login` profili varsa boş bırakılabilir.
ANTHROPIC_API_KEY=

# Ajan ve hakem modeli (Anthropic model kimliği). Bütün sistemler aynı ajan modeliyle koşar.
LBENCH_AGENT_MODEL=
LBENCH_JUDGE_MODEL=

# Legaluga MCP (https://mcp.legaluga.com/mcp) erişim belirteci
LEGALUGA_MCP_TOKEN=
# LEGALUGA_MCP_URL=https://mcp.legaluga.com/mcp

# Legal Data Hunter MCP
LDH_MCP_URL=
LDH_API_KEY=

# Yargı MCP yerel komutu (pip install yargi-mcp; ayrı bir sanal ortamda kurulması önerilir)
# YARGI_MCP_COMMAND=/path/to/venv/bin/yargi-mcp

# Koşu çıktılarının dizini (varsayılan: ./results)
# LBENCH_RESULTS_DIR=
